{
  "name": "bid-equalization",
  "version": "1.0.0",
  "description": "SAP CAP Bid Equalization System for Procurement",
  "repository": "<repository-url>",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.2.0",
    "@sap-cloud-sdk/http-client": "^4.3.0",
    "@sap-cloud-sdk/resilience": "^4.2.0",
    "@sap/cds": "^9.8.0",
    "@sap/xssec": "^4.12.1",
    "express": "^4",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.1.2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --livereload false",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "watch-rfq-events": "cds watch --open rfqevents/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-freestyle": "cds watch --open freestyle-app/webapp/index.html --livereload false",
    "watch-formula-admin-app": "cds watch --open com.aramco.formulaadminapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy bid-equalization --delete-services --delete-service-keys --delete-service-brokers",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "connectivity": true,
    "destinations": true,
    "requires": {
      "db": {
        "kind": "hana"
      },
      "uaa": {
        "kind": "xsuaa"
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "Mbohra-v@Ejada.com": {}
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/rfq-events",
    "app/formula-admin-app"
  ]
}
