{
  "_version": "1.83.0",
  "sap.app": {
    "id": "rfqevents",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "39619ece-42eb-4af2-81d9-3b6bcd45fe44"
    },
    "dataSources": {
      "mainService": {
        "uri": "/api/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.146.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "rfqevents.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "RFQEventsList",
          "target": "RFQEventsList"
        },
        {
          "pattern": "RFQEvents({key}):?query:",
          "name": "RFQEventsObjectPage",
          "target": "RFQEventsObjectPage"
        },
        {
          "pattern": "RFQEvents({key})/items({key2}):?query:",
          "name": "RFQItemsObjectPage",
          "target": "RFQItemsObjectPage"
        }
      ],
      "targets": {
        "RFQEventsList": {
          "type": "Component",
          "id": "RFQEventsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/RFQEvents",
              "variantManagement": "Page",
              "navigation": {
                "RFQEvents": {
                  "detail": {
                    "route": "RFQEventsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "RFQEventsObjectPage": {
          "type": "Component",
          "id": "RFQEventsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/RFQEvents",
              "navigation": {
                "items": {
                  "detail": {
                    "route": "RFQItemsObjectPage"
                  }
                }
              },
              "controllerExtensions": {
                "rfqevents.ext.controller.RFQEventsObjectPageExt": {}
              },
              "controlConfiguration": {
                "items/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Single"
                  },
                  "actions": {
                    "OpenEqualization": {
                      "press": "rfqevents.ext.handler.ItemActions.openEqualization",
                      "text": "Open Bid Equalization",
                      "enabled": true,
                      "requiresSelection": true
                    }
                  }
                }
              }
            }
          }
        },
        "RFQItemsObjectPage": {
          "type": "Component",
          "id": "RFQItemsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/RFQEvents/items"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
