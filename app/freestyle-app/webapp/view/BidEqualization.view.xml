<!--
    Bid Equalization – Main Comparison View
    Two-column side-by-side form:
      Left  = Benchmark Bid (Foreign/Imported Supplier)
      Right = Local Bid
-->
<mvc:View
    controllerName="bidequalization.controller.BidEqualization"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:uxap="sap.uxap"
    xmlns:core="sap.ui.core"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    displayBlock="true">

    <uxap:ObjectPageLayout
        id="mainPage"
        busy="{appModel>/busy}"
        showTitleInHeaderContent="true"
        alwaysShowContentHeader="false"
        showHeaderContent="true" visible="false">

        <!-- ═══ HEADER ════════════════════════════════════════════════════ -->
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:heading>
                    <Title text="Bid Equalization" level="H1" />
                </uxap:heading>
                <uxap:snappedHeading>
                    <Title text="Bid Equalization" level="H2" />
                </uxap:snappedHeading>
                <uxap:expandedContent>
                    <FlexBox direction="Row" wrap="Wrap" alignItems="Center" id="headerData">
                        <ObjectAttribute id= "eventId" title="RFQ"       text="{rfq_EventId}" class="sapUiSmallMarginEnd" />
                        <ObjectAttribute title="Item"      text="{itemNo}"  class="sapUiSmallMarginEnd" />
                        <ObjectAttribute title="Commodity" text="{commodity}"     class="sapUiSmallMarginEnd" />
                        <ObjectAttribute title="Quantity"  text="{quantity}" />
                    </FlexBox>
                </uxap:expandedContent>
                <uxap:snappedContent>
                    <Text text="{rfq/eventName} – {itemNo}" />
                </uxap:snappedContent>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:headerContent>
            <FlexBox direction="Column">
                <ObjectAttribute
    title="Formula"
    class="sapUiSmallMarginBottom"
    id="formulaExpr"
    text="{
        path: 'formulaExpr',
        mode: 'sap.ui.model.BindingMode.OneWay'
    }"/>
                
            </FlexBox>
        </uxap:headerContent>

        <uxap:sections>

            <!-- ═══ SECTION 1: Saved Comparisons ═════════════════════════ -->
            <uxap:ObjectPageSection title="Saved Comparisons" id="savedSection">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <uxap:blocks>
                            <Table
    id="comparisonsTable"
    items="{
  path: '/BidComparisons',
  parameters: {
    expand: 'additionalFields,supplierLeft,supplierRight,winnerSupplier'
  },
  sorter: {
    path: 'createdAt',
    descending: true
  }
}"
    noDataText="No saved comparisons yet."
    growing="true"
    growingThreshold="5"
    mode="SingleSelectLeft"
    selectionChange=".onComparisonSelected">

    <columns>
        <Column><Text text="Date" /></Column>
        <Column><Text text="Benchmark Supplier" /></Column>
        <Column><Text text="Local Supplier" /></Column>
        <Column hAlign="End"><Text text="Equalized (Benchmark)" /></Column>
        <Column hAlign="End"><Text text="Equalized (Local)" /></Column>
       <Column hAlign="End"><Text text="Difference" /></Column>
       <Column hAlign="End"><Text text="Difference (%)" /></Column>
        <Column><Text text="Notes" /></Column>
        <Column><Text text="PDF" /></Column>
        <Column><Text text="Delete" /></Column>
    </columns>

    <items>
        <ColumnListItem type="Active">
            <cells>
                <Text text="{createdAt}" />
                <Text text="{leftVendorName}" />
                <Text text="{rightVendorName}" />

                <ObjectNumber number="{leftEqualizedBid}" />
                <ObjectNumber number="{rightTotalLocalBid}" />
                <ObjectNumber number="{rightCommodityDifference}" />
                <ObjectNumber number="{rightDifference}" />

                <Text text="{notes}" />
                <Button
                    icon="sap-icon://pdf-attachment"
                    press=".onGeneratePDF" />

                <Button
                    icon="sap-icon://delete"
                    type="Reject"
                    press=".onDeleteComparison" />
                
                <!-- <Button
                    icon="sap-icon://view"
                    type="Default"
                    press=".onDeleteComparison" /> -->
            </cells>
        </ColumnListItem>
    </items>

</Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- ═══ SECTION 2: Bid Comparison – Two-Column Form ══════════ -->
            <uxap:ObjectPageSection title="Bid Comparison" id="comparisonSection">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <uxap:blocks>

                            <!-- Two columns side by side (Grid = reliable 50/50) -->
                            <l:Grid defaultSpan="L6 M12 S12" hSpacing="1" width="100%">

                                <!-- ── LEFT: Benchmark Bid (Foreign/Imported) ── -->
                                <Panel
                                    headerText="Benchmark Bid – Foreign / Imported Supplier"
                                    expandable="false"
                                    expanded="true"
                                    width="100%"
                                    class="sapUiSmallMarginBottom">

                                    <f:SimpleForm
                                        editable="true"
                                        layout="ResponsiveGridLayout"
                                        labelSpanL="5" labelSpanM="5" labelSpanS="12"
                                       
                                        columnsL="1" columnsM="1"
                                        class="sapUiSmallMargin">
                                        <f:content>

                                            <!-- Vendor Name -->
                                            <Label text="Vendor Name" required="true" />
                                            <Input
                                                id="leftVendorInput"                                                
                                                value="{path: 'leftVendorName',
                                                mode:'sap.ui.model.BindingMode.OneWay'}"                                                
                                                placeholder="Search vendor..."
                                                showValueHelp="true"
                                                valueHelpRequest=".onVendorHelp"
                                                width="100%">
                                                <customData><core:CustomData key="side" value="left" /></customData>
                                            </Input>

                                            <!-- Benchmark Bid Type -->
                                            <Label text="Benchmark Bid Type" />
                                            
                                            <Select id="leftBenchmarkBidType" selectedKey="{
    path: 'leftBenchmarkBidType',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'BID_TYPE' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>

                                            <!-- Port of Export -->
                                            <Label text="Port of Export" />
                                            <Select id="leftPortOfExport" selectedKey="{
    path: 'leftPortOfExport',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'PORT' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>

                                            <!-- Benchmark Bid Value -->
                                            <Label text="Benchmark Bid Value" required="true" />
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="leftBenchmarkBidValue" value="{
    path: 'leftBenchmarkBidValue',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }"
                                                placeholder="0.00" width="65%" class="sapUiTinyMarginEnd"/>
                                               <Select id="leftBenchmarkCurrency" selectedKey="{
    path: 'leftBenchmarkCurrency',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>
                                            </FlexBox>

                                            <!-- Development Type -->
                                            <Label text="Development Type" />
                                             <Select id="leftDevelopmentType" selectedKey="{
    path: 'leftDevelopmentType',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'DEV_TYPE' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>

                                            <!-- Delivery Mode -->
                                            <Label text="Delivery Mode" />
                                            <Select id="leftDeliveryMode"
                                            selectedKey="{
    path: 'leftDeliveryMode',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'DELIVERY_MODE' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>

                                            <!-- Benchmark Bid Value Range -->
                                            <Label text="Bid Value Range" />
                                            <Select id="leftBidValueRange" selectedKey="{
    path: 'leftBidValueRange',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'BENCH_BID_VAL_RANGE' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>

                                            <!-- Exceptional Weight / Curve Ratio -->
                                            <Label text="Exceptional Weight / Curve Ratio" />
                                            <Select id="leftCurveRatio" selectedKey="{
    path: 'leftCurveRatio',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }" items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CUBE_RATIO' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
                                            </Select>

                                            <!-- Benchmark End Use Cost -->
                                            <Label text="Benchmark End Use Cost" required="true"/>
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id='leftEndUseCost' value="{
    path: 'leftEndUseCost',
    
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }" 
                                                placeholder="0.00" width="65%" class="sapUiTinyMarginEnd" />
                                                <Select id="leftEndUseCostCurrency" selectedKey="{
    path: 'leftEndUseCostCurrency',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }" 
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>
                                            </FlexBox>

                                            <!-- Shipping Cost -->
                                            <Label text="Shipping Cost" required="true"/>
                                            <FlexBox direction="Row" alignItems="Center">
                                            <Input id="leftShippingCost" value="{
    path: 'leftShippingCost',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }"

  placeholder="0.00" width="65%" class="sapUiTinyMarginEnd" />
    <Select id="leftShippingCostCurrency" selectedKey="{
    path: 'leftShippingCostCurrency',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }" 
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>
                                            </FlexBox>

                                            <!-- Handling Cost -->
                                            <Label text="Handling Cost" required="true"/>
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="leftHandlingCost"
                                                value="{
    path: 'leftHandlingCost',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }"
                                                placeholder="0.00" width="65%" class="sapUiTinyMarginEnd" />
                                                <Select id="leftHandlingCostCurrency" selectedKey="{
    path: 'leftHandlingCostCurrency',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>
                                            </FlexBox>

                                            <!-- Saudi Customs Rate -->
                                            <Label text="Saudi Customs Rate (%)" />
                                            <Input id="leftSaudiCustomsRate"  value="{
    path: 'leftSaudiCustomsRate',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }" placeholder="0.00" width="100%" />

                                            <!-- Saudi Manufacturer Premium -->
                                            <Label text="Saudi Manufacturer Premium (%)" />
                                            <Input id="leftSaudiManufacturerPremium" value="{
    path: 'leftSaudiManufacturerPremium',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }"
                                            placeholder="0.00" width="100%" />

                                            <!-- Freight (Traffic) -->
                                            <Label text="Freight (Traffic)" />
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="leftFreight" value="{
    path: 'leftFreight',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }" 
  placeholder="0.00" width="65%" class="sapUiTinyMarginEnd" editable="false" />

                                                <Select id="leftFreightCurrency" 
                                                editable="false" selectedKey="{
    path: 'leftFreightCurrency',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
    
</Select>
                                            </FlexBox>

                                            <!-- Duty -->
                                            <Label text="Duty" />
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="leftDuty" value="{
    path: 'leftDuty',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }"
   placeholder="0.00" width="65%" class="sapUiTinyMarginEnd" editable="false" />
                                                <Select id="leftDutyCurrency" selectedKey="{
    path: 'leftDutyCurrency',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }" editable="false"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>
                                            </FlexBox>

                                            <!-- Premium -->
                                            <Label text="Premium" />
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="leftPremium" value="{
    path: 'leftPremium',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }" placeholder="0.00" width="65%" class="sapUiTinyMarginEnd" editable="false"/>
                                                <Select id="leftPremiumCurrency" editable="false" selectedKey="{
    path: 'leftPremiumCurrency',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>
 </FlexBox>


 <!-- LDOR -->
                                            <Label text="LDOR" />
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="leftldor" value="{
    path: 'leftldor',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }" placeholder="0.00" width="65%" class="sapUiTinyMarginEnd" editable="false"/>
                                                <Select id="leftldorCurrency" editable="false" selectedKey="{
    path: 'leftPremiumCurrency',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>
 </FlexBox>


                                        <!-- Equalized Bid -->
                                            <Label text="Equalized Bid" />
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="leftEqualizedBid" editable="false"
                                                value="{
    path: 'leftEqualizedBid',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }"/>
                                            </FlexBox>





                                           

                                        </f:content>
                                    </f:SimpleForm>
                                </Panel>

                                <!-- ── RIGHT: Local Bid ─────────────────────────── -->
                                <Panel
                                    headerText="🔹 Local Bid – Domestic Supplier"
                                    expandable="false"
                                    expanded="true"
                                    width="100%"
                                    class="sapUiSmallMarginBottom">

                                    <f:SimpleForm
                                        editable="true"
                                        layout="ResponsiveGridLayout"
                                        labelSpanL="5" labelSpanM="5" labelSpanS="12"
                                        
                                        columnsL="1" columnsM="1"
                                        class="sapUiSmallMargin">
                                        <f:content>

                                            <!-- Vendor Name -->
                                            <Label text="Vendor Name" required="true" />
                                            <Input
                                                id="rightVendorInput"
                                                value="{path: 'rightVendorName',
                                                mode:'sap.ui.model.BindingMode.OneWay'}"                                                
                                                placeholder="Search vendor..."
                                                showValueHelp="true"
                                                valueHelpRequest=".onVendorHelp"
                                                width="100%">
                                                <customData><core:CustomData key="side" value="right" /></customData>
                                            </Input>

                                            <!-- Local Bid Type -->
                                            <Label text="Local Bid Type" />
                                            <Select id="rightLocalBidType" selectedKey="{
    path: 'rightLocalBidType',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'LOCAL_BID_TYPE' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>

                                            <!-- Local Bid Value -->
                                            <Label text="Local Bid Value" required="true" />
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="rightLocalBidValue" value="{
    path: 'rightLocalBidValue',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }" placeholder="0.00" width="65%" class="sapUiTinyMarginEnd" change=".onLocalValuesChange" />
                                                <Select id="rightLocalBidCurrency" selectedKey="{
    path: 'leftHandlingCostCurrency',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>
                                            </FlexBox>

                                            <!-- Local End Use Cost -->
                                            <Label text="Local End Use Cost" required="true" />
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="rightLocalEndUseCost"
                                                required="true"
                                                value="{
    path: 'rightLocalEndUseCost',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }" placeholder="0.00" width="65%" class="sapUiTinyMarginEnd" change=".onLocalValuesChange" />
                                                <Select id="rightLocalEndUseCostCurrency"
    items="{
        path: 'vh>/SelectItems',
        filters: [{ path: 'category', operator: 'EQ', value1: 'CURRENCY' }],
        sorter: { path: 'sequence' }
    }">

    <core:Item key="{vh>code}" text="{vh>text}" />
</Select>
                                            </FlexBox>

                                            <!-- Total Local Bid -->
                                            <Label text="Total Local Bid" />
                                            <Input id="rightTotalLocalBid"
                                                value="{
    path: 'rightTotalLocalBid',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }"
                                                placeholder="Calculated automatically"
                                                editable="false"
                                                width="100%"
                                                class="sapUiSmallMarginBottom" />

                                            <!-- Equalization Basis -->
                                            <Label text="Equalization Basis" />
                                            <Select id="rightEqualizationBasis" 
                                            selectedKey="{
    path: 'rightEqualizationBasis',
    mode: 'sap.ui.model.BindingMode.OneWay'
  }" change=".onDropdownChange" width="100%">
                                                <core:Item key=""          text="-- Select --" />
                                                <core:Item key="PROVINCE"  text="Province Discussion" />
                                                <core:Item key="NATIONAL"  text="National Average" />
                                                <core:Item key="MARKET"    text="Market Rate" />
                                                <core:Item key="NEGOTIATED" text="Negotiated" />
                                            </Select>

                                            <!-- Commodity Difference -->
                                            <Label text="Difference" />
                                            <Input id="rightCommodityDifference"
                                            editable="false" 
                                            value="{
    path: 'rightCommodityDifference',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }" placeholder="0.00" width="100%" />

                                            <!-- Difference (calculated) -->
                                            <Label text="Difference (%)" />
                                            <FlexBox direction="Row" alignItems="Center">
                                                <Input id="rightDifference"
                                                    value="{
    path: 'rightDifference',
    mode:'sap.ui.model.BindingMode.OneWay',
    type: 'sap.ui.model.odata.type.Decimal',
    constraints: { precision: 15, scale: 2 }
  }"
                                                    placeholder="Calculated"
                                                    editable="false"
                                                    width="100%" />
                                                
                                            </FlexBox>

                                        </f:content>
                                    </f:SimpleForm>

                                    <!-- Equalization Result Banner -->
                                    <MessageStrip
                                        text="🏆 Winner: {appModel>/winnerName}"
                                        type="Success"
                                        showIcon="true"
                                        visible="false"
                                        class="sapUiSmallMargin sapUiSmallMarginTop"/>

                                        <VBox width="60%">
  <Toolbar>
    <Title text="Additional Fields"/>
    <ToolbarSpacer/>
    <Button icon="sap-icon://add" press="onAddRightField"/>
  </Toolbar>

  <Table items="{appModel>/rightAdditionalFields}">
    <columns>
      <Column width="40%"><Text text="Field"/></Column>
      <Column width="60%"><Text text="Value"/></Column>
    </columns>

    <items>
      <ColumnListItem>
        <cells>
          <Input value="{appModel>fieldName}"/>
          <Input value="{appModel>fieldValue}"/>
        </cells>
      </ColumnListItem>
    </items>
  </Table>
</VBox>

                                </Panel>
                            </l:Grid>

                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- ═══ SECTION 3: Actions ════════════════════════════════════ -->
            <uxap:ObjectPageSection title="Actions" id="actionsSection">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <uxap:blocks>
                            <FlexBox direction="Row" wrap="Wrap" alignContent="Start">
                                <Button
                                    text="Calculate"
                                    type="Emphasized"                                    
                                    press=".onCalculate"
                                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom" />
                                <Button
                                    text="Save Comparison"
                                    type="Default"
                                    icon="sap-icon://save"
                                    press=".onSaveComparison"
                                    enabled="{appModel>/calculated}"
                                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom" />
                                <Button
                                    text="Mark as Benchmark"
                                    type="Default"
                                    icon="sap-icon://flag"
                                    press=".onMarkBenchmark"
                                    enabled="{appModel>/calculated}"
                                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom" visible="false"/>
                                <Button
                                    text="Generate PDF"
                                    type="Default"
                                    icon="sap-icon://pdf-attachment"
                                    press=".onGeneratePDF"
                                    enabled="{= !!${appModel>/lastComparisonID} }"
                                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom" 
                                    visible="false"/>
                                <Button
                                    text="Reset"
                                    type="Transparent"
                                    icon="sap-icon://reset"
                                    press=".onReset"
                                    class="sapUiSmallMarginBottom" visible="false"
                                    />
                            </FlexBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
